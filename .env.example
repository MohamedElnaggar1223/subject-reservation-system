# Environment for local development.
# Copy the API block to apps/api/.env and the web block to apps/web/.env.local.
# Every variable the API reads is listed; anything marked optional can stay unset.

#==========================================
# API (apps/api/.env)
#==========================================

NODE_ENV=development
PORT=3001

# Local Postgres: the igcse-dev-db container from README.md
DATABASE_URL=postgresql://audit:auditpass@127.0.0.1:5433/igcse_audit

# Required, at least 32 characters: openssl rand -base64 32
# Left empty on purpose: the API refuses to start until you set your own.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Web origins allowed to call the API (comma-separated). APP_URL is used in email links.
# Setting CORS_ORIGINS replaces the built-in defaults (src/env.ts), which also allow the
# Expo app's app:// and exp:// origins; add those back when mobile work starts.
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000

# Optional. Production: .yourdomain.com so api. and app. share the session cookie.
COOKIE_DOMAIN=

# Require a verified email before sign-in. Keep false locally; true in production.
REQUIRE_EMAIL_VERIFICATION=false

# Rate limits (these are the defaults)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=50
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=600

# Email via Resend. Optional: unset means stub mode, where emails are logged and never sent.
# The integration suite blanks this key whatever you put here.
RESEND_API_KEY=
EMAIL_FROM=IGCSE System <noreply@school.com>

# School receiving account shown to parents paying by InstaPay. InstaPay has no
# merchant API: parents transfer to this account and submit the transaction
# reference, which finance verifies against the bank statement.
SCHOOL_BANK_NAME=National Bank of Egypt
SCHOOL_ACCOUNT_NAME=IGCSE School
SCHOOL_ACCOUNT_NUMBER=0012345678901234
SCHOOL_IBAN=

# File storage on Cloudflare R2. Optional locally, but without it avatar and
# document uploads fail (there is no local fallback). Keep the bucket private;
# files are served through signed URLs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# The Fawry and Paymob integrations are disabled since V3 (V3_PLAN.md §6.11).
# Leave their keys unset.

#==========================================
# WEB (apps/web/.env.local)
#==========================================

NEXT_PUBLIC_API_URL=http://localhost:3001

#==========================================
# MOBILE (apps/app/.env.local)
#==========================================
# The Expo app is still the starter template, kept for future mobile work.
# On a device, use your machine's LAN address instead of localhost.

EXPO_PUBLIC_API_URL=http://localhost:3001
